    trial-omen,
    raid-omen,
    wind-charged,
    weaving,
    oozing,
    infested,
  }

  record status-effect-instance {
    effect-type: status-effect-type,
    duration: u32,
    amplifier: u8,
    ambient: bool,
    show-particles: bool,
    show-icon: bool,
  }
}

interface text {
  use common.{named-color, rgb-color, argb-color};

  resource text-component {
    /// Creates a plain text component.
    text: static func(plain: string) -> text-component;
    /// Creates a translation component.
    translate: static func(key: string, %with: list<text-component>) -> text-component;
    /// Creates a translation component with a Bedrock-specific fallback key.
    translate-cross: static func(java-key: string, bedrock-key: string, %with: list<text-component>) -> text-component;
    /// Creates an entity names / selector text component.
    entity-names: static func(selector: string, separator: option<string>) -> text-component;
    /// Creates a keybind text component (e.g., "key.jump").
    keybind: static func(keybind: string) -> text-component;
    /// Creates a custom translation component.
    custom: static func(namespace: string, key: string, locale: string, %with: list<text-component>) -> text-component;
    /// Parses a legacy Minecraft formatted string (using section signs '§' by default) into a text component.
    from-legacy-string: static func(input: string) -> text-component;
    /// Parses a legacy formatted string using a custom color code symbol (e.g. '&' or '§').
    from-legacy-string-with-code: static func(input: string, code-symbol: char) -> text-component;
    /// Parses a standard Minecraft JSON text component.
    from-json: static func(json: string) -> result<text-component, string>;
    /// Serializes the text component to JSON format.
    to-json: func() -> string;
    add-child: func(child: text-component);
    add-text: func(text: string);
    get-text: func() -> string;
    encode: func() -> list<u8>;
    to-pretty-console: func() -> string;
    /// Style
    color-named: func(color: named-color);
    color-rgb: func(color: rgb-color);
    gradient-named: func(colors: list<named-color>);
    gradient: func(colors: list<rgb-color>);
    rainbow: func();
    bold: func(value: bool);
    italic: func(value: bool);
    underlined: func(value: bool);
    strikethrough: func(value: bool);
    obfuscated: func(value: bool);
    /// Text inserted into chat when shift-clicked
    insertion: func(text: string);
    font: func(font: string);
    shadow-color: func(color: argb-color);
    /// Click events
    click-open-url: func(url: string);
    click-open-file: func(path: string);
    click-run-command: func(command: string);
    click-suggest-command: func(command: string);
    click-change-page: func(page: u32);
    click-copy-to-clipboard: func(text: string);
    /// Hover events
    hover-show-text: func(text: text-component);
    /// Item data as SNBT string
    hover-show-item: func(item: string);
    hover-show-entity: func(entity-type: string, id: string, name: option<text-component>);
  }
}

interface advancement {
  use text.{text-component};

  /// Frame type for an advancement.
  enum frame-type {
    task,
    challenge,
    goal,
  }

  /// Display information for an advancement.
  record advancement-display {
    title: text-component,
    description: text-component,
    frame: frame-type,
    show-toast: bool,
    hidden: bool,
    announce-to-chat: bool,
    background: option<string>,
    x: f32,
    y: f32,
  }

  /// Detailed information about an advancement.
  record advancement-info {
    id: string,
    parent-id: option<string>,
    criteria: list<string>,
    display: option<advancement-display>,
  }

  /// Represents progress of an advancement for a player.
  record advancement-progress {
    advancement-id: string,
    done: bool,
    awarded-criteria: list<string>,
    remaining-criteria: list<string>,
  }
}

interface enchantments {
  use text.{text-component};

  /// Equipment slot where an enchantment is active.
  enum attribute-modifier-slot {
    any,
    main-hand,
    off-hand,
    hand,
    feet,
    legs,
    chest,
    head,
    armor,
    body,
    saddle,
  }

  /// Vanilla enchantments enum.
  enum enchantment {
    aqua-affinity,
    bane-of-arthropods,
    binding-curse,
    blast-protection,
    breach,
    channeling,
    density,
    depth-strider,
    efficiency,
    feather-falling,
    fire-aspect,
    fire-protection,
    flame,
    fortune,
    frost-walker,
    impaling,
    infinity,
    knockback,
    looting,
    loyalty,
    luck-of-the-sea,
    lunge,
    lure,
    mending,
    multishot,
    piercing,
    power,
    projectile-protection,
    protection,
    punch,
    quick-charge,
    respiration,
    riptide,
    sharpness,
    silk-touch,
    smite,
    soul-speed,
    sweeping-edge,
    swift-sneak,
    thorns,
    unbreaking,
    vanishing-curse,
    wind-burst,
  }

  /// Represents a custom enchantment definition.
  record custom-enchantment {
    /// Unique identifier for the enchantment (e.g. "my_plugin:lifesteal").
    id: string,
    /// Description or display name of the enchantment.
    description: text-component,
    /// Maximum level of the enchantment (e.g. 1..=10).
    max-level: u32,
    /// Base anvil repair/combination cost multiplier.
    anvil-cost: u32,
    /// Tag or item pattern for supported items (e.g. "#minecraft:enchantable/weapon").
    supported-items: string,
    /// Weight / rarity of the enchantment (higher = more common, default 5).
    weight: u32,
    /// Equipment slots where this enchantment is active.
    slots: list<attribute-modifier-slot>,
    /// List of exclusive/conflicting enchantment IDs.
    exclusive-set: list<string>,
  }

  /// Global manager for registering and querying custom enchantments.
  resource enchantment-manager {
    /// Registers a new custom enchantment with the server.
    register-enchantment: func(enchantment: custom-enchantment) -> result<_, string>;
    /// Gets an enchantment definition by its ID.
    get-enchantment: func(id: string) -> option<custom-enchantment>;
    /// Checks if an enchantment ID is registered.
    has-enchantment: func(id: string) -> bool;
    /// Returns all registered custom enchantment IDs.
    get-all-enchantment-ids: func() -> list<string>;
  }
}

interface forms {
  use text.{text-component};

  enum image-type {
    url,
    path,
  }

  record form-image {
    %type: image-type,
    data: string,
  }

  record simple-form-button {
    text: text-component,
    image: option<form-image>,
  }

  record simple-form {
    title: text-component,
    content: text-component,
    buttons: list<simple-form-button>,
  }

  record modal-form {
    title: text-component,
    content: text-component,
    button1: text-component,
    button2: text-component,
  }

  variant custom-form-element {
    label(text-component),
    toggle(tuple<text-component, bool>),
    slider(tuple<text-component, f32, f32, f32, f32>),
    /// text, min, max, step, default
    step-slider(tuple<text-component, list<string>, u32>),
    /// text, steps, default
    dropdown(tuple<text-component, list<string>, u32>),
    /// text, options, default
    input(tuple<text-component, string, string>),
  }

  record custom-form {
    title: text-component,
    elements: list<custom-form-element>,
  }

  variant form {
    simple(simple-form),
    modal(modal-form),
    custom(custom-form),
  }
}

interface item-stack {
  use attributes.{attribute, attribute-modifier};
  use data-components.{data-component};
  use enchantments.{attribute-modifier-slot, enchantment};
  use text.{text-component};
  use common.{nbt-entry, nbt-tree, nbt-tag};

  /// Represents an enchantment and its level.
  record enchantment-value {
    enchantment: enchantment,
    level: u32,
  }

  /// Represents a custom enchantment and its level on an item stack.
  record custom-enchantment-value {
    enchantment-id: string,
    level: u32,
  }

  /// Represents an attribute modifier applied to an item stack for a specific slot.
  record item-attribute-modifier {
    attribute: attribute,
    modifier: attribute-modifier,
    slot: attribute-modifier-slot,
  }

  /// Represents a data component and its serialized value.
  record data-component-value {
    component: data-component,
    /// The serialized value of the component.
    value: list<u8>,
  }

  resource item-stack {
    constructor(registry-key: string, count: u8);
    /// Returns the unique registry key of the item (e.g., "minecraft:diamond").
    get-registry-key: func() -> string;
    /// Returns the number of items in the stack.
    get-count: func() -> u8;
    /// Sets the number of items in the stack.
    set-count: func(count: u8);
    /// Returns the maximum number of items that can be in this stack.
    get-max-count: func() -> u8;
    /// Returns all enchantments on this item stack.
    get-enchantments: func() -> list<enchantment-value>;
    /// Adds an enchantment to this item stack.
    add-enchantment: func(enchantment: enchantment, level: u32);
    /// Removes an enchantment from this item stack.
    remove-enchantment: func(enchantment: enchantment);
    /// Returns all custom enchantments on this item stack.
    get-custom-enchantments: func() -> list<custom-enchantment-value>;
    /// Adds a custom enchantment to this item stack.
    add-custom-enchantment: func(enchantment-id: string, level: u32);
    /// Removes a custom enchantment from this item stack.
    remove-custom-enchantment: func(enchantment-id: string);
    /// Returns the level of a custom enchantment on this item stack, if present.
    get-custom-enchantment-level: func(enchantment-id: string) -> option<u32>;
    /// Returns whether this item stack has a specific custom enchantment.
    has-custom-enchantment: func(enchantment-id: string) -> bool;
    /// Returns all attribute modifiers on this item stack.
    get-attribute-modifiers: func() -> list<item-attribute-modifier>;
    /// Adds an attribute modifier to this item stack.
    add-attribute-modifier: func(modifier: item-attribute-modifier);
    /// Removes all attribute modifiers for a specific attribute from this item stack.
    remove-attribute-modifiers: func(attribute: attribute);
    /// Clears all custom attribute modifiers from this item stack.
    clear-attribute-modifiers: func();
    /// Returns the lore of this item stack.
    get-lore: func() -> list<text-component>;
    /// Sets the lore of this item stack.
    set-lore: func(lore: list<text-component>);
    /// Adds a line to the lore of this item stack.
    add-lore: func(line: text-component);
    /// Returns the custom name of this item stack, if set.
    get-custom-name: func() -> option<text-component>;
    /// Sets the custom name of this item stack.
    set-custom-name: func(name: option<text-component>);
    /// Sets a namespaced custom data value on this item stack.
    set-custom-data: func(namespace: string, key: string, value: nbt-tree);
    /// Returns a namespaced custom data value from this item stack, if set.
    get-custom-data: func(namespace: string, key: string) -> option<nbt-tree>;
    /// Removes a namespaced custom data value from this item stack.
    remove-custom-data: func(namespace: string, key: string);
    /// Returns whether this item stack has a namespaced custom data value.
    has-custom-data: func(namespace: string, key: string) -> bool;
    /// Returns all data components on this item stack.
    get-components: func() -> list<data-component-value>;
    /// Sets a data component on this item stack.
    set-component: func(component: data-component, value: list<u8>);
    /// Removes a data component from this item stack.
    remove-component: func(component: data-component);
  }
}

interface inventory {
  use item-stack.{item-stack};
  use common.{hand};

  /// Common inventory resource used across GUIs, player inventories, and containers.
  resource inventory {
    /// Returns the number of slots in this inventory.
    get-size: func() -> u32;
    /// Returns true if all slots in this inventory are empty.
    is-empty: func() -> bool;
    /// Returns the item in the specified slot index, or none if empty.
    get-item: func(slot: u32) -> option<item-stack>;
    /// Sets the item in the specified slot index.
    set-item: func(slot: u32, item: option<item-stack>);
    /// Removes and returns the item in the specified slot index.
    remove-item: func(slot: u32) -> option<item-stack>;
    /// Clears all items from this inventory.
    clear: func();
    /// Returns all items in this inventory as a list of slots.
    get-all-items: func() -> list<option<item-stack>>;
    /// Sets all items in this inventory from a list.
    set-all-items: func(items: list<option<item-stack>>);
    /// Counts the total number of items with the given ID in this inventory.
    count-item: func(item-id: string) -> u32;
    /// Checks if the inventory contains at least one item with the given ID.
    contains-item: func(item-id: string) -> bool;
  }

  /// Specialized player inventory handle providing access to main inventory, armor, offhand, and hotbar.
  resource player-inventory {
    /// Returns the generic 36-slot inventory handle (hotbar + main storage).
    as-inventory: func() -> inventory;
    /// Returns the item currently held in the specified hand.
    get-item-in-hand: func(hand: hand) -> option<item-stack>;
    /// Sets the item in the specified hand.
    set-item-in-hand: func(hand: hand, item: option<item-stack>);
    /// Returns the currently selected hotbar slot index (0-8).
    get-selected-slot: func() -> u8;
    /// Sets the currently selected hotbar slot index (0-8).
    set-selected-slot: func(slot: u8);
    /// Armor slot accessors
    get-helmet: func() -> option<item-stack>;
    set-helmet: func(item: option<item-stack>);
    get-chestplate: func() -> option<item-stack>;
    set-chestplate: func(item: option<item-stack>);
    get-leggings: func() -> option<item-stack>;
    set-leggings: func(item: option<item-stack>);
    get-boots: func() -> option<item-stack>;
    set-boots: func(item: option<item-stack>);
    get-off-hand: func() -> option<item-stack>;
    set-off-hand: func(item: option<item-stack>);
    /// Clears all armor slots.
    clear-armor: func();
    /// Clears the 36 main inventory slots.
    clear-main: func();
    /// Clears all slots (main inventory, armor, offhand).
    clear-all: func();
  }
}

interface block-entity {
  use common.{block-pos, nbt-tree};
  use item-stack.{item-stack};
  use inventory.{inventory};

  resource block-entity {
    resource-location: func() -> string;
    get-position: func() -> block-pos;
    get-id: func() -> u32;
    is-dirty: func() -> bool;
    clear-dirty: func();
    /// Sets a namespaced custom data value on this block entity.
    set-custom-data: func(namespace: string, key: string, value: nbt-tree);
    /// Returns a namespaced custom data value from this block entity, if set.
    get-custom-data: func(namespace: string, key: string) -> option<nbt-tree>;
    /// Removes a namespaced custom data value from this block entity.
    remove-custom-data: func(namespace: string, key: string);
    /// Returns whether this block entity has a namespaced custom data value.
    has-custom-data: func(namespace: string, key: string) -> bool;
  }

  resource container-block-entity {
    get-block-entity: func() -> block-entity;
    /// Returns the generic inventory handle for this container.
    get-inventory: func() -> inventory;
    get-size: func() -> u32;
    is-empty: func() -> bool;
    get-stack: func(slot: u32) -> option<item-stack>;
    set-stack: func(slot: u32, stack: option<item-stack>);
    remove-stack: func(slot: u32) -> option<item-stack>;
    clear: func();
  }

  resource command-block-entity {
    get-block-entity: func() -> block-entity;
    last-output: func() -> string;
    track-output: func() -> bool;
    success-count: func() -> u32;
    command: func() -> string;
    auto: func() -> bool;
    condition-met: func() -> bool;
    powered: func() -> bool;
  }

  enum dye-color {
    white,
    orange,
    magenta,
    light-blue,
    yellow,
    lime,
    pink,
    gray,
    light-gray,
    cyan,
    purple,
    blue,
    brown,
    green,
    red,
    black,
  }

  record sign-text {
    messages: list<string>,
    color: dye-color,
    has-glowing-text: bool,
  }

  resource sign-block-entity {
    get-block-entity: func() -> block-entity;
    get-front-text: func() -> sign-text;
    set-front-text: func(text: sign-text);
    get-back-text: func() -> sign-text;
    set-back-text: func(text: sign-text);
    is-waxed: func() -> bool;
    set-waxed: func(waxed: bool);
  }

  resource jukebox-block-entity {
    get-block-entity: func() -> block-entity;
    get-container: func() -> container-block-entity;
    is-playing: func() -> bool;
    stop-playing: func();
    start-playing: func(length-in-ticks: u64);
  }

  resource chest-block-entity {
    get-block-entity: func() -> block-entity;
    get-container: func() -> container-block-entity;
    viewer-count: func() -> u32;
  }

  resource mob-spawner-block-entity {
    get-block-entity: func() -> block-entity;
    get-spawn-count: func() -> s32;
    get-spawn-range: func() -> s32;
    get-delay: func() -> s32;
  }

  resource map-block-entity {
    get-block-entity: func() -> block-entity;
    get-map-id: func() -> s32;
