    fly-speed: f32,
    vertical-fly-speed: f32,
    walk-speed: f32,
  }

  record serialized-abilities-data {
    target-player-raw-id: s64,
    player-permissions: player-permission-level,
    command-permissions: command-permission-level,
    layers: list<serialized-abilities-data-serialized-layer>,
  }

  record actor-link {
    ridden-unique-id: s64,
    rider-unique-id: s64,
    link-type: u8,
    immediate: bool,
    rider-initiated: bool,
    vehicle-angular-velocity: f32,
  }

  record c-container-open {
    container-id: u8,
    container-type: u8,
    position: tuple<s32, s32, s32>,
    target-entity-id: s64,
  }

  record c-correct-player-move-prediction {
    prediction-type: u8,
    pos: tuple<f64, f64, f64>,
    pos-delta: tuple<f64, f64, f64>,
    rotation: tuple<f64, f64>,
    vehicle-angular-velocity: option<f32>,
    on-ground: bool,
    tick: s64,
  }

  record recipe-item-descriptor-item {
    identifier: string,
    metadata-value: s32,
  }

  variant recipe-item-descriptor {
    empty,
    item(recipe-item-descriptor-item),
    tag(string),
  }

  record item-descriptor-count {
    descriptor: recipe-item-descriptor,
    count: s32,
  }

  record recipe-unlock-requirement {
    context: s32,
  }

  enum creative-category {
    all,
    construction,
    nature,
    equipment,
    items,
    item-command-only,
    undefined,
  }

  record c-disconnect {
    reason: s32,
    skip-message: bool,
    message: string,
    filtered-message: string,
  }

  enum rule-value {
    null,
  }

  record game-rule {
    rule-name: string,
    rule-can-be-modified: bool,
    rule-value: rule-value,
  }

  record c-gamerules-changed {
    rule-data: list<game-rule>,
  }

  record item-data {
    item-name: string,
    item-id: s32,
    is-component-based: bool,
    item-version: s32,
    component-data: list<u8>,
  }

  record c-item-registry {
    items: list<item-data>,
  }

  record item-stack-response-slot-info {
    requested-slot: u8,
    slot: u8,
    amount: u8,
    item-stack-net-id: s32,
    custom-name: string,
    filtered-custom-name: string,
    durability-correction: s32,
  }

  record c-level-event {
    event-id: s32,
    position: tuple<f64, f64, f64>,
    data: s32,
  }

  enum level-event {
    particles-destroy-block,
    block-start-break,
    block-stop-break,
    block-update-break,
  }

  record c-level-sound-event {
    sound-event: string,
    position: tuple<f64, f64, f64>,
    data: s32,
    actor-identifier: string,
    is-baby: bool,
    is-global: bool,
    actor-unique-id: s64,
    fire-at-position: option<tuple<f64, f64, f64>>,
  }

  record c-mob-effect {
