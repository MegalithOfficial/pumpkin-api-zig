    craft-creative(item-stack-request-action-craft-creative),
    optional(item-stack-request-action-optional),
    grindstone(item-stack-request-action-grindstone),
    loom(item-stack-request-action-loom),
    craft-non-implemented,
    craft-results-deprecated(item-stack-request-action-craft-results-deprecated),
  }

  record item-stack-request {
    request-id: s32,
    actions: list<item-stack-request-action>,
    filter-strings: list<string>,
    filter-cause: s32,
  }

  record s-item-stack-request {
    requests: list<item-stack-request>,
  }

  record s-player-auth-input {
    pitch: f32,
    yaw: f32,
    position: tuple<f64, f64, f64>,
    move-vec: tuple<f64, f64>,
    head-yaw: f32,
    input-data: list<s64>,
    input-mode: s32,
    play-mode: s32,
    interaction-model: s32,
    interact-pitch: f32,
    interact-yaw: f32,
    tick: s64,
    delta: tuple<f64, f64, f64>,
    block-actions: option<list<player-block-action>>,
    item-interaction: option<player-inventory-action>,
    item-stack-request: option<item-stack-request>,
    vehicle-rotation: option<tuple<f64, f64>>,
    vehicle-unique-id: option<s64>,
    analog-move: tuple<f64, f64>,
    camera-orientation: tuple<f64, f64, f64>,
    raw-move: tuple<f64, f64>,
  }

  record c-inventory-content {
    container-id: s32,
    slots: list<network-item-stack-descriptor>,
    full-container-name: full-container-name,
    storage-item: network-item-stack-descriptor,
  }

  record c-inventory-slot {
    container-id: s32,
    slot: s32,
    full-container-name: option<full-container-name>,
    storage-item: option<network-item-stack-descriptor>,
    item: network-item-stack-descriptor,
  }

  record item-stack-response-container-info {
    full-container-name: full-container-name,
    slots: list<item-stack-response-slot-info>,
  }

  record item-stack-response-info {
    %result: u8,
    client-request-id: s32,
    containers: list<item-stack-response-container-info>,
  }

  record c-item-stack-response {
    responses: list<item-stack-response-info>,
  }

  record network-item-stack {
    id: s32,
    count: s32,
    aux-value: s32,
    block-runtime-id: s32,
    extra-data: list<u8>,
  }

  variant serverbound-packet {
    s-actor-event(s-actor-event),
    s-animate(s-animate),
    s-block-pick-request(s-block-pick-request),
    s-client-cache-blob-status(s-client-cache-blob-status),
    s-client-cache-status(s-client-cache-status),
    s-command-request(s-command-request),
    s-container-close(s-container-close),
    s-emote(s-emote),
    s-emote-list(s-emote-list),
    s-interact(s-interact),
    s-inventory-transaction(s-inventory-transaction),
    s-item-stack-request(s-item-stack-request),
    s-loading-screen(s-loading-screen),
    s-login(s-login),
    s-mob-equipment(s-mob-equipment),
    s-modal-form-response(s-modal-form-response),
    s-packet-violation-warning(s-packet-violation-warning),
    s-player-action(s-player-action),
    s-player-auth-input(s-player-auth-input),
    s-player-hotbar(s-player-hotbar),
    s-request-ability(s-request-ability),
    s-request-chunk-radius(s-request-chunk-radius),
    s-request-network-settings(s-request-network-settings),
    s-resource-pack-client-response(s-resource-pack-client-response),
    s-respawn(s-respawn),
    s-set-local-player-as-initialized(s-set-local-player-as-initialized),
    s-set-player-inventory-options(s-set-player-inventory-options),
    s-text(s-text),
    unknown,
  }

  variant clientbound-packet {
    c-add-actor(c-add-actor),
    c-add-item-actor(c-add-item-actor),
    c-add-player(c-add-player),
    c-available-commands(c-available-commands),
    c-biome-definition-list,
    c-block-actor-data(c-block-actor-data),
    c-block-event(c-block-event),
    c-boss-event(c-boss-event),
    c-change-dimension(c-change-dimension),
    c-chunk-radius-updated(c-chunk-radius-updated),
    c-client-cache-miss-response(c-client-cache-miss-response),
    c-container-open(c-container-open),
    c-correct-player-move-prediction(c-correct-player-move-prediction),
    c-crafting-data(c-crafting-data),
    c-creative-content(c-creative-content),
    c-disconnect(c-disconnect),
    c-gamerules-changed(c-gamerules-changed),
    c-inventory-content(c-inventory-content),
    c-inventory-slot(c-inventory-slot),
    c-item-registry(c-item-registry),
    c-item-stack-response(c-item-stack-response),
    c-jigsaw-structure-data,
    c-level-event(c-level-event),
    c-level-sound-event(c-level-sound-event),
    c-mob-effect(c-mob-effect),
    c-mob-equipment(c-mob-equipment),
    c-modal-form-request(c-modal-form-request),
    c-move-actor-absolute(c-move-actor-absolute),
    c-move-actor-delta(c-move-actor-delta),
    c-move-player(c-move-player),
    c-network-chunk-publisher-update(c-network-chunk-publisher-update),
    c-network-settings(c-network-settings),
    c-play-status(c-play-status),
    c-player-hotbar(c-player-hotbar),
    c-player-list(c-player-list),
    c-remove-actor(c-remove-actor),
    c-remove-objective(c-remove-objective),
    c-resource-pack-stack-packet(c-resource-pack-stack-packet),
    c-resource-packs-info(c-resource-packs-info),
    c-set-actor-data(c-set-actor-data),
    c-set-actor-link(c-set-actor-link),
    c-set-actor-motion(c-set-actor-motion),
    c-set-difficulty(c-set-difficulty),
    c-set-display-objective(c-set-display-objective),
    c-set-health(c-set-health),
    c-set-player-game-type(c-set-player-game-type),
    c-set-score(c-set-score),
    c-set-spawn-position(c-set-spawn-position),
    c-set-time(c-set-time),
    c-set-title(c-set-title),
    c-show-credits(c-show-credits),
    c-start-game(c-start-game),
    c-take-item-actor(c-take-item-actor),
    c-transfer(c-transfer),
    c-update-abilities(c-update-abilities),
    c-update-attributes(c-update-attributes),
    c-update-block(c-update-block),
    c-update-trade(c-update-trade),
    c-voxel-shapes,
    unknown,
  }
}

interface java-packets {
  use uuid.{uuid};

  record config-s-client-information-config {
    locale: string,
    view-distance: u8,
    chat-mode: s32,
    chat-colors: bool,
    skin-parts: u8,
    main-hand: s32,
    text-filtering: bool,
    server-listing: bool,
  }

  record config-s-config-cookie-response {
    key: string,
    has-payload: bool,
    payload: option<list<u8>>,
  }

  record config-s-custom-click-action {
    action-id: string,
    payload: option<list<u8>>,
  }

  record config-s-keep-alive {
    keep-alive-id: s64,
  }

  record config-s-known-packs {
    known-packs: list<string>,
  }

  record config-s-plugin-message {
    channel: string,
    data: list<u8>,
  }

  record config-s-config-pong {
    id: s32,
  }

  variant resource-pack-response-result {
    download-success,
    download-fail,
    downloaded,
    accepted,
    declined,
    invalid-url,
    reload-failed,
    discarded,
    unknown(s32),
  }

  record config-s-config-resource-pack {
    uuid: uuid,
    %result: s32,
  }

  record login-s-login-cookie-response {
    key: string,
    payload: option<list<u8>>,
  }

  record s-encryption-response {
    shared-secret: list<u8>,
    verify-token: list<u8>,
  }

  record login-s-login-start {
    name: string,
    uuid: uuid,
  }

  record login-s-login-plugin-response {
    message-id: s32,
    data: option<list<u8>>,
  }

  record s-attack {
    entity-id: s32,
  }

  record s-block-entity-tag-query {
    transaction-id: s32,
    location: tuple<s32, s32, s32>,
  }

  record s-bundle-item-selected {
    slot-id: s32,
    selected-item-index: s32,
  }

  record s-change-difficulty {
    difficulty: string,
  }

  record s-change-game-mode {
    game-mode: string,
  }

  record s-chat-ack {
    offset: s32,
  }

  record s-chat-command {
    command: string,
  }

  record argument-signature {
    name: string,
    signature: list<u8>,
  }

  record s-chat-command-signed {
    command: string,
    timestamp: s64,
    salt: s64,
    argument-signatures: list<argument-signature>,
    message-count: s32,
    acknowledged: list<u8>,
    checksum: u8,
  }

  record s-chat-message {
    message: string,
    timestamp: s64,
    salt: s64,
    signature: option<list<u8>>,
    message-count: s32,
    acknowledged: list<u8>,
    checksum: u8,
  }

  record s-chunk-batch {
    chunks-per-tick: f32,
  }

  enum slot-action-type {
    pickup,
    quick-move,
    swap,
    clone,
    throw,
    quick-craft,
    pickup-all,
  }

  record s-click-slot {
    sync-id: s32,
    revision: s32,
    slot: s32,
    button: u8,
    mode: slot-action-type,
    length-of-array: s32,
    array-of-changed-slots: list<tuple<s32, string>>,
    carried-item: string,
  }

  record s-client-command {
    action-id: s32,
  }

  record s-client-information-play {
    locale: string,
    view-distance: u8,
    chat-mode: s32,
    chat-colors: bool,
    skin-parts: u8,
    main-hand: s32,
    text-filtering: bool,
    server-listing: bool,
  }

  record s-close-container {
    window-id: s32,
  }

  record s-command-suggestion {
    id: s32,
    command: string,
  }

  record s-confirm-teleport {
    teleport-id: s32,
    position: tuple<f64, f64, f64>,
    yaw: f32,
    pitch: f32,
  }

  record s-container-button-click {
    window-id: s32,
    button-id: s32,
  }

  record s-container-slot-state-changed {
    slot-id: s32,
    container-id: s32,
    new-state: bool,
  }

  record s-cookie-response {
    key: string,
    payload: option<list<u8>>,
  }

  record s-custom-click-action {
    action-id: string,
    payload: option<list<u8>>,
  }

  record s-custom-payload {
    channel: string,
    data: list<u8>,
  }

  record s-debug-sample-subscription {
    sample-type: s32,
  }

  record s-debug-subscription-request {
    sample-type: s32,
  }

  record s-edit-book {
    slot: s32,
    pages: list<string>,
    title: option<string>,
  }

  record s-entity-tag-query {
    transaction-id: s32,
    entity-id: s32,
  }

  record s-interact {
    entity-id: s32,
    r-type: s32,
    target-position: option<tuple<f64, f64, f64>>,
    hand: option<s32>,
    sneaking: bool,
  }

  enum action-type {
    interact,
    attack,
    interact-at,
  }

  record s-jigsaw-generate {
    pos: tuple<s32, s32, s32>,
    levels: s32,
    keep-jigsaws: bool,
  }

  record s-keep-alive {
    keep-alive-id: s64,
  }

  record s-lock-difficulty {
    locked: bool,
  }

  record s-move-vehicle {
    x: f64,
    y: f64,
    z: f64,
    yaw: f32,
    pitch: f32,
    on-ground: bool,
  }

  record s-paddle-boat {
    left-paddle: bool,
    right-paddle: bool,
  }

  record s-pick-item-from-block {
    pos: tuple<s32, s32, s32>,
    include-data: bool,
  }

  record s-pick-item-from-entity {
    id: s32,
    include-data: bool,
  }

  record s-play-ping-request {
    payload: s64,
  }

  record s-place-recipe {
    container-id: u8,
    recipe-display-id: s32,
    use-max-items: bool,
  }

  record s-player-abilities {
    %flags: u8,
    fly-speed: option<f32>,
    walk-speed: option<f32>,
  }

  record s-player-action {
    status: s32,
    position: tuple<s32, s32, s32>,
    face: u8,
    sequence: s32,
  }

  enum status {
    started-digging,
    cancelled-digging,
    finished-digging,
    drop-item-stack,
    drop-item,
    release-item-in-use,
    swap-item,
    spear-jab,
    change-destroy-direction,
  }

  enum action {
    start-sneaking,
    stop-sneaking,
    leave-bed,
    start-sprinting,
    stop-sprinting,
    start-horse-jump,
    stop-horse-jump,
    open-vehicle-inventory,
    start-flying-elytra,
  }

  record s-player-command {
    entity-id: s32,
    action: action,
    jump-boost: s32,
  }

  record s-set-player-ground {
    on-ground: bool,
  }

  record s-player-input {
    input: u8,
  }

  record s-player-position {
    position: tuple<f64, f64, f64>,
    collision: u8,
  }

  record s-player-position-rotation {
    position: tuple<f64, f64, f64>,
    yaw: f32,
    pitch: f32,
    collision: u8,
  }

  record s-player-rotation {
    yaw: f32,
    pitch: f32,
    ground: bool,
  }

  record s-player-session {
    session-id: uuid,
    expires-at: s64,
    public-key: list<u8>,
    key-signature: list<u8>,
  }

  record s-play-pong {
    id: s32,
  }

  record s-recipe-book-change-settings {
    book-type: s32,
    is-open: bool,
    is-filtering: bool,
  }

  record s-recipe-book-seen-recipe {
    recipe-display-id: s32,
  }

  record s-rename-item {
    item-name: string,
  }

  variant play-resource-pack-result {
    download-success,
    declined,
    download-fail,
    accepted,
    downloaded,
    invalid-url,
    reload-failed,
    discarded,
    unknown(s32),
  }

  record s-play-resource-pack {
    uuid: uuid,
    %result: s32,
  }

  variant s-seen-advancement {
    open-tab(string),
    close-tab,
  }

  record s-select-trade {
    selected-slot: s32,
  }

  record s-set-beacon {
    primary-effect: option<s32>,
    secondary-effect: option<s32>,
  }

  record s-set-command-block {
    pos: tuple<s32, s32, s32>,
    command: string,
    mode: s32,
    %flags: u8,
  }

  enum command-block-mode {
    chain,
    repeating,
    impulse,
  }

  record s-set-command-minecart {
    entity-id: s32,
    command: string,
    track-output: bool,
  }

  record s-set-creative-slot {
    slot: s32,
    clicked-item: string,
  }

  record game-rule-entry {
    game-rule-key: string,
    value: string,
  }

  record s-set-game-rule {
    entries: list<game-rule-entry>,
  }

  record s-set-held-item {
    slot: s32,
  }

  record s-set-jigsaw-block {
    pos: tuple<s32, s32, s32>,
    name: string,
    target: string,
    pool: string,
    final-state: string,
    joint: string,
    selection-priority: s32,
    placement-priority: s32,
  }

  record s-set-structure-block {
    location: tuple<s32, s32, s32>,
    action: s32,
    mode: s32,
    name: string,
    offset-x: u8,
    offset-y: u8,
    offset-z: u8,
    size-x: u8,
    size-y: u8,
    size-z: u8,
    mirror: s32,
    rotation: s32,
    metadata: string,
    integrity: f32,
    seed: s64,
    %flags: u8,
  }

  enum test-block-mode {
    start,
    log,
    fail,
    accept,
  }

  record s-set-test-block {
    position: tuple<s32, s32, s32>,
    mode: test-block-mode,
    message: string,
  }

  record s-spectate-entity {
    target: uuid,
  }

  record s-swing-arm {
    hand: s32,
  }

  record s-teleport-to-entity {
    target: uuid,
  }

  enum test-instance-block-action {
    init,
    query,
    set,
    reset,
    save,
    %export,
    run,
  }

  record var-int-vector3 {
    x: s32,
    y: s32,
    z: s32,
  }

  enum test-instance-block-status {
    cleared,
    running,
    success,
    failed,
  }

  record test-instance-block-data {
    test: option<string>,
    size: var-int-vector3,
    rotation: string,
    ignore-entities: bool,
    status: test-instance-block-status,
    error-message: option<string>,
  }

  record s-test-instance-block-action {
    pos: tuple<s32, s32, s32>,
    action: test-instance-block-action,
    data: test-instance-block-data,
  }

  record s-update-sign {
    location: tuple<s32, s32, s32>,
    is-front-text: bool,
    line-1: string,
    line-2: string,
    line-3: string,
    line-4: string,
  }

  record s-use-item {
    hand: s32,
    sequence: s32,
    yaw: f32,
    pitch: f32,
  }

  record s-use-item-on {
    hand: s32,
    position: tuple<s32, s32, s32>,
    face: s32,
    cursor-pos: tuple<f64, f64, f64>,
    inside-block: bool,
    is-against-world-border: bool,
    sequence: s32,
  }

  record status-s-status-ping-request {
    payload: s64,
  }

  record config-c-config-add-resource-pack {
    uuid: uuid,
    url: string,
    hash: string,
    forced: bool,
    prompt-message: option<string>,
  }

  record config-c-code-of-conduct {
    code-of-conduct: string,
  }

  record config-c-config-disconnect {
    reason: string,
  }

  record config-c-cookie-request {
    key: string,
  }

  record config-c-config-custom-report-details {
    details: list<tuple<string, string>>,
  }

  record config-c-feature-flags {
    features: list<string>,
  }

  record config-c-known-packs {
    known-packs: list<string>,
  }

  record config-c-config-ping {
    id: s32,
  }

  record config-c-plugin-message {
    channel: string,
    data: list<u8>,
  }

  record config-c-config-post-effects {
    effects: list<string>,
  }

  record config-c-registry-data {
    registry-id: string,
    entries: list<string>,
  }

  record config-c-config-remove-resource-pack {
    uuid: option<uuid>,
  }

  record config-c-config-server-links {
    links: list<string>,
  }

  record config-c-config-show-dialog {
    dialog: string,
  }

  record config-c-store-cookie {
    key: string,
    payload: list<u8>,
  }

  record config-c-transfer {
    host: string,
    port: s32,
  }

  record config-c-update-tags {
    tags: list<string>,
  }

  record login-c-login-cookie-request {
    key: string,
  }

  record c-encryption-request {
    server-id: string,
    public-key: list<u8>,
    verify-token: list<u8>,
    should-authenticate: bool,
  }

  record login-c-login-disconnect {
    json-reason: string,
  }

  record login-c-login-plugin-request {
    message-id: s32,
    channel: string,
    data: list<u8>,
  }

  record login-c-set-compression {
    threshold: s32,
  }

  record c-acknowledge-block-change {
    sequence-id: s32,
  }

  record c-action-bar {
    action-bar: string,
  }

  record c-add-resource-pack {
    uuid: uuid,
    url: string,
    hash: string,
    forced: bool,
    prompt-message: option<string>,
  }

  record statistic {
    category-id: s32,
    statistic-id: s32,
    value: s32,
  }

  record c-award-stats {
    stats: list<statistic>,
  }

  record c-set-block-destroy-stage {
    entity-id: s32,
    location: tuple<s32, s32, s32>,
    destroy-stage: u8,
  }

  record c-block-entity-data {
    location: tuple<s32, s32, s32>,
    r-type: s32,
    nbt-data: list<u8>,
  }

  record c-block-event {
    location: tuple<s32, s32, s32>,
    action-id: u8,
    action-parameter: u8,
    block-type: s32,
  }

  record c-block-update {
    location: tuple<s32, s32, s32>,
    state-id: s32,
  }

  record bossevent-action-add {
    title: string,
    health: f32,
    color: s32,
    division: s32,
    %flags: u8,
  }

  record bossevent-action-update-style {
    color: s32,
    dividers: s32,
  }

  variant bossevent-action {
    add(bossevent-action-add),
    remove,
    update-health(f32),
    update-tile(string),
    update-style(bossevent-action-update-style),
    update-flags(u8),
  }

  record c-boss-event {
    uuid: uuid,
    action: bossevent-action,
  }

  record c-center-chunk {
    chunk-x: s32,
    chunk-z: s32,
  }

  record c-change-difficulty {
    difficulty: u8,
    locked: bool,
  }

  record c-chunk-batch-end {
    batch-size: s32,
  }

  record chunk-heightmaps {
    world-surface: option<list<s64>>,
    motion-blocking: option<list<s64>>,
    motion-blocking-no-leaves: option<list<s64>>,
  }

  record chunk-block-entity {
    packed-xz: u8,
    y: s32,
    type-id: s32,
    data: string,
  }

  record chunk-biome-entry {
    chunk-x: s32,
    chunk-z: s32,
    data: list<u8>,
  }

  record c-chunks-biomes {
    chunks: list<chunk-biome-entry>,
  }

  record c-clear-title {
    reset: bool,
  }

