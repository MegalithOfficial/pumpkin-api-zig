    slot-index: u8,
    cancelled: bool,
  }

  record vehicle-block-collision-event-data {
    vehicle-id: s32,
    block-pos: block-pos,
    cancelled: bool,
  }

  record vehicle-collision-event-data {
    vehicle-id: s32,
    cancelled: bool,
  }

  record vehicle-create-event-data {
    vehicle-id: s32,
    cancelled: bool,
  }

  record vehicle-damage-event-data {
    vehicle-id: s32,
    damage: f32,
    attacker-id: option<s32>,
    cancelled: bool,
  }

  record vehicle-destroy-event-data {
    vehicle-id: s32,
    attacker-id: option<s32>,
    cancelled: bool,
  }

  record vehicle-enter-event-data {
    vehicle-id: s32,
    entered-id: s32,
    cancelled: bool,
  }

  record vehicle-entity-collision-event-data {
    vehicle-id: s32,
    collided-entity-id: s32,
    cancelled: bool,
  }

  record vehicle-exit-event-data {
    vehicle-id: s32,
    exited-id: s32,
    cancelled: bool,
  }

  record vehicle-move-event-data {
    vehicle-id: s32,
    from-position: position,
    to-position: position,
    cancelled: bool,
  }

  record vehicle-update-event-data {
    vehicle-id: s32,
    cancelled: bool,
  }

  record enchantment-offer {
    cost: s32,
    enchantment-id: s32,
    enchantment-level: s32,
  }

  record prepare-item-enchant-event-data {
    player: player,
    item: item-stack,
    offers: list<enchantment-offer>,
    bookshelf-count: s32,
    cancelled: bool,
  }

  record enchantment-value {
    enchantment: enchantment,
    level: u32,
  }

  record enchant-item-event-data {
    player: player,
    item: item-stack,
    %option: s32,
    cost: s32,
    enchantments-to-add: list<enchantment-value>,
    cancelled: bool,
  }

  record lightning-strike-event-data {
    position: position,
    is-effect: bool,
    cancelled: bool,
  }

